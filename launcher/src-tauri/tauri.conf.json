{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YW4 Recomp",
  "version": "1.0.1",
  "identifier": "io.github.ilfforever.yw4recomp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yo-kai Watch 4 Recomp",
        "width": 1100,
        "height": 732,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "maximizable": false,
        "maxWidth": 1600,
        "maxHeight": 1000,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/screenshots/*",
          "**/work/icon/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
